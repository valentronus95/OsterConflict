# Python helper cache files are generated by local tooling and must never appear as source changes.
__pycache__/
*.py[cod]

# Local validation/playtest output. These files are generated on each PC and must never be committed.
PC_TEST/TEST_RESULTS/
PC_TEST/*_LAST.log
PC_TEST/*_IMPORT_LAST.log
Logs/*.log
*_IMPORT_STATE.txt

# BTR-4 upload has no redistribution license/readme and references a GTA SA mod source.
# Keep its source bytes and derived Unreal production asset local-development-only while this repo is public.
OsterConflict/SourceAssets/Production/Vehicles/BTR4/BTR4_Bucephalus.fbx
OsterConflict/SourceAssets/Production/Vehicles/BTR4/Textures/
OsterConflict/Content/Production/Vehicles/BTR4/

# Local Fab / Marketplace / donor imports. These remain available to the local UE project but must not flood
# Git changes or be published blindly before provenance and runtime acceptance are complete.
